<div style="margin-top:20px;">
  <button 
    id="request-purchase-btn"
    type="button"
    style="
      width:100%;
      padding:12px;
      background:#000;
      color:#fff;
      border:none;
      cursor:pointer;
      font-size:16px;
    "
  >
    Request Purchase
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const email = prompt('Enter approver email address:');
        if (!email) return;

        try {
          // Get cart from Shopify
          const cart = await fetch('/cart.js').then(r => r.json());

          // Use Shopify App Proxy URL or full backend URL in dev
          const BACKEND_URL = '/apps/request-purchase';

          const response = await fetch(BACKEND_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, cart })
          });

          const result = await response.json();
          alert(result.success ? 'Request Sent!' : 'Error sending request.');
        } catch (err) {
          console.error("Error sending request:", err);
          alert('Error sending request.');
        }
      });
    });
  </script>
</div>

{% schema %}
{
  "name": "Request Purchase Button",
  "target": "section",
  "settings": []
}
{% endschema %}
