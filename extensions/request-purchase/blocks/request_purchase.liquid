{% assign is_manager = false %}
{% if customer and customer.tags contains 'manager' %}
  {% assign is_manager = true %}
{% endif %}

<div style="margin-top:20px">

{% if customer and is_manager %}

  <!-- MANAGER → NORMAL CHECKOUT -->
  <a href="/checkout"
     style="display:block;width:100%;padding:12px;
            background:#000;color:#fff;text-align:center;
            text-decoration:none;font-size:16px;">
    Checkout
  </a>

{% elsif customer %}

  <!-- EMPLOYEE → REQUEST PURCHASE -->
  <button id="request-purchase-btn"
    style="width:100%;padding:12px;background:#000;
           color:#fff;border:none;font-size:16px;">
    Request Purchase
  </button>

  <div id="request-modal" style="display:none; position:fixed; inset:0;
       background:rgba(0,0,0,0.6); z-index:9999;">
    <div style="background:#fff;padding:30px;
         max-width:420px;margin:100px auto;border-radius:10px;">
      <h3>Request Purchase</h3>

      <input id="recipient-email" type="email" placeholder="Approver Email"
        style="width:100%;padding:8px;margin-bottom:10px;" />

      <input id="requester-name" type="text" placeholder="Your Name"
        style="width:100%;padding:8px;margin-bottom:10px;" />

      <input id="requester-location" type="text" placeholder="Location"
        style="width:100%;padding:8px;margin-bottom:20px;" />

      <button id="send-request-btn"
        style="width:100%;padding:12px;background:#000;color:#fff;">
        Send Request
      </button>
    </div>
  </div>

  <script>
    const modal = document.getElementById('request-modal');
    document.getElementById('request-purchase-btn').onclick = () => modal.style.display = "block";

    document.getElementById('send-request-btn').onclick = async () => {
      const email = document.getElementById('recipient-email').value;
      const senderName = document.getElementById('requester-name').value;
      const senderLocation = document.getElementById('requester-location').value;

      if (!email || !senderName || !senderLocation) {
        alert("All fields required");
        return;
      }

      modal.style.display = "none";

      const cart = await fetch('/cart.js').then(r => r.json());

      await fetch("https://purchase-request-13ki.onrender.com/apps/request-purchase", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          cart,
          senderName,
          senderLocation
        })
      });

      alert("Request sent!");
    };
  </script>

{% else %}

  <!-- GUEST → NORMAL CHECKOUT -->
  <a href="/checkout"
     style="display:block;width:100%;padding:12px;
            background:#000;color:#fff;text-align:center;
            text-decoration:none;font-size:16px;">
    Checkout
  </a>

{% endif %}
</div>

{% schema %}
{
  "name": "Purchase Control Button",
  "target": "section",
  "settings": []
}
{% endschema %}
