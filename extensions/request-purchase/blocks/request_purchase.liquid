<div style="margin-top:20px" class="button-wrapper-2">
  <button id="request-purchase-btn" type="button"
    style="width:100%;padding:12px;background:#000;color:#fff;border:none;cursor:pointer;font-size:16px;">
    Request Purchase
  </button>

  {% if customer and customer.default_address %}
    <script>
      window.REQUESTER = {
        email: "{{ customer.email | escape }}",
        first_name: "{{ customer.default_address.first_name | default: customer.first_name | escape }}",
        last_name: "{{ customer.default_address.last_name | default: customer.last_name | escape }}",
        address1: "{{ customer.default_address.address1 | escape }}",
        address2: "{{ customer.default_address.address2 | escape }}",
        city: "{{ customer.default_address.city | escape }}",
        province: "{{ customer.default_address.province | escape }}",
        zip: "{{ customer.default_address.zip | escape }}",
        country: "{{ customer.default_address.country | escape }}"
      };
      console.log("REQUESTER loaded with default address:", window.REQUESTER);
    </script>
  {% elsif customer %}
    <script>
      window.REQUESTER = {
        email: "{{ customer.email | escape }}",
        first_name: "{{ customer.first_name | escape }}",
        last_name: "{{ customer.last_name | escape }}",
        address1: "",
        address2: "",
        city: "",
        province: "",
        zip: "",
        country: ""
      };
      console.warn("⚠️ Customer has NO default_address. Loaded fallback minimal profile:", window.REQUESTER);
    </script>
  {% else %}
    <script>
      window.REQUESTER = null;
      console.warn("⚠️ No logged-in customer, REQUESTER is null.");
    </script>
  {% endif %}

  <!-- MODAL -->
  <div id="rp-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;
       background:rgba(0,0,0,0.45);z-index:99999;align-items:center;justify-content:center;">
    <div style="background:#fff;padding:24px;border-radius:8px;width:90%;max-width:420px;box-shadow:0 4px 20px rgba(0,0,0,0.3);">
      <h3 style="margin-top:0;font-size:20px;">Send Purchase Request</h3>

      <label style="font-size:14px;margin-bottom:6px;display:block;">Recipient Email</label>
      <input id="rp-modal-input" type="email" placeholder="recipient@example.com"
             style="width:100%;padding:10px;border:1px solid #ccc;border-radius:6px;margin-bottom:16px;font-size:15px;" />

      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button id="rp-cancel"
                style="padding:10px 14px;border:1px solid #666;background:#fff;color:#333;border-radius:6px;cursor:pointer;">
          Cancel
        </button>
        <button id="rp-submit"
                style="padding:10px 14px;background:#000;color:#fff;border:none;border-radius:6px;cursor:pointer;">
          Send Request
        </button>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      const modal = document.getElementById('rp-modal');
      const cancelBtn = document.getElementById('rp-cancel');
      const submitBtn = document.getElementById('rp-submit');
      const input = document.getElementById('rp-modal-input');

      if (!btn) return;

      // Backend → correctly using the route
      const BACKEND_URL = "https://purchase-request-13ki.onrender.com/request-purchase";

      btn.addEventListener('click', () => {
        input.value = "";
        modal.style.display = "flex";
        setTimeout(() => input.focus(), 50);
      });

      cancelBtn.addEventListener('click', () => modal.style.display = "none");

      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.style.display = "none";
      });

      submitBtn.addEventListener('click', async () => {
        const recipient = input.value.trim();
        if (!recipient) {
          alert("Please enter a valid email.");
          return;
        }

        modal.style.display = "none";

        try {
          const cart = await fetch('/cart.js').then(r => r.json());
          const requester = window.REQUESTER;

          console.log("Sending purchase request payload:", {
            recipient_email: recipient,
            cart,
            requester
          });

          const resp = await fetch(BACKEND_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: recipient,
              cart,
              requester
            })
          });

          let result;
          try { result = await resp.json(); } catch (e) { result = null; }

          if (resp.ok && result?.success) {
            alert("Request sent! The recipient will receive an invoice link.");
            console.log("Draft Order:", result.draft_id, "Invoice URL:", result.invoice_url);
          } else {
            alert("Error sending request. Check console.");
            console.error("Backend error:", resp.status, result);
          }

        } catch (err) {
          console.error("Fetch error:", err);
          alert("Error sending request.");
        }
      });
    });
  </script>
</div>

{% schema %}
{
  "name": "Request Purchase Button",
  "target": "section",
  "settings": []
}
{% endschema %}
