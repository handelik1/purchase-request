<div style="margin-top:20px">
  <button id="request-purchase-btn" type="button"
    style="width:100%;padding:12px;background:#000;color:#fff;border:none;cursor:pointer;font-size:16px;">
    Request Purchase
  </button>

  {% if customer %}
    <script>
      window.REQUESTER = {
        email: "{{ customer.email | escape }}",
        first_name: "{{ customer.default_address.first_name | escape }}",
        last_name: "{{ customer.default_address.last_name | escape }}",
        address1: "{{ customer.default_address.address1 | escape }}",
        address2: "{{ customer.default_address.address2 | escape }}",
        city: "{{ customer.default_address.city | escape }}",
        province: "{{ customer.default_address.province | escape }}",
        zip: "{{ customer.default_address.zip | escape }}",
        country: "{{ customer.default_address.country | escape }}"
      };
      console.log("REQUESTER set:", window.REQUESTER);
    </script>
  {% endif %}

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const recipient = prompt("Enter the email of the person who should receive this request:");
        if (!recipient) return;

        try {
          const cart = await fetch('/cart.js').then(r => r.json());
          const requester = window.REQUESTER || null;
          console.log("Posting request:", { recipient, cart, requester });

          const resp = await fetch('/apps/request-purchase', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: recipient, cart, requester })
          });

          let result;
          try { result = await resp.json(); } catch(e) { result = null; }

          if (resp.ok && result?.success) {
            alert("Request sent! The recipient will receive an invoice link.");
            console.log("Draft ID:", result.draft_id, "Invoice:", result.invoice_url);
          } else {
            alert("Error sending request. Check console.");
            console.error("Request error:", resp.status, result);
          }

        } catch (err) {
          console.error("Fetch error:", err);
          alert("Error sending request.");
        }
      });
    });
  </script>
</div>
