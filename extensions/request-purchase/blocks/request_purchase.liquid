<div style="margin-top:20px;">
  <button id="request-purchase-btn" type="button" style="width:100%;padding:12px;background:#000;color:#fff;border:none;cursor:pointer;font-size:16px;">
    Request Purchase
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const email = prompt('Enter your email to request purchase:');
        if (!email) return;

        try {
          const BACKEND = '/apps/request-purchase'; // Shopify App Proxy path

          const response = await fetch(BACKEND, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          });

          let result;
          try {
            result = await response.json();
          } catch (e) {
            console.error("Non-JSON response:", await response.text());
            result = null;
          }

          if (response.ok && result?.success) {
            alert('Request Sent!');
          } else {
            alert('Error sending request.');
            console.error("Request error:", response.status, result);
          }

        } catch (err) {
          console.error("Fetch error:", err);
          alert('Error sending request.');
        }
      });
    });
  </script>
</div>
