<div style="margin-top:20px;">
  <button 
    id="request-purchase-btn" 
    type="button"
    style="width:100%;padding:12px;background:#000;color:#fff;border:none;cursor:pointer;font-size:16px;">
    Request Purchase
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const email = prompt('Enter email address to send request to:');
        if (!email) return;

        try {
          console.log("Fetching cart...");
          const cart = await fetch('/cart.js').then(r => r.json());
          console.log("Cart:", cart);

          // --- APP PROXY URL ---
          const BACKEND = `/apps/request-purchase?shop={{ shop.permanent_domain }}`;
          console.log("Backend POST URL:", BACKEND);

          // --- SEND REQUEST ---
          const response = await fetch(BACKEND, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, cart })
          });

          // --- HANDLE RESPONSE ---
          let result;
          try {
            result = await response.json();
          } catch (err) {
            console.warn("Non-JSON response from server:", err);
            try {
              console.log("Raw response:", await response.text());
            } catch (e) {}
            result = null;
          }

          if (response.ok && result?.success) {
            alert('Request Sent!');
          } else {
            alert('Error sending request.');
            console.error("Request failed:", response.status, result);
          }

        } catch (err) {
          console.error("Fatal fetch error:", err);
          alert('Error sending request.');
        }
      });
    });
  </script>
</div>

{% schema %}
{
  "name": "Request Purchase Button",
  "target": "section",
  "settings": []
}
{% endschema %}
