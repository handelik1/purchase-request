<div style="margin-top:20px;">
  <button 
    id="request-purchase-btn"
    type="button"
    style="
      width:100%;
      padding:12px;
      background:#000;
      color:#fff;
      border:none;
      cursor:pointer;
      font-size:16px;
    "
  >
    Request Purchase
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      console.log("Request Purchase button loaded:", btn);
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const email = prompt('Enter email address to send request to:');
        console.log("Email entered:", email);
        if (!email) return;

        try {
          const cart = await fetch('/cart.js').then(r => r.json());
          console.log("Cart data:", cart);

          // Use App Proxy URL
          const BACKEND_URL = '/apps/request-purchase';
          console.log("Using BACKEND_URL:", BACKEND_URL);

          const response = await fetch(BACKEND_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, cart })
          });

          const result = await response.json();
          console.log("Server response:", result);

          alert(result.success ? 'Request Sent!' : 'Error sending request.');
        } catch (e) {
          console.error("Error sending request:", e);
          alert('Error sending request.');
        }
      });
    });
  </script>
</div>

{% schema %}
{
  "name": "Request Purchase Button",
  "target": "section",
  "settings": []
}
{% endschema %}
