<div style="margin-top:20px;">
  <button 
    id="request-purchase-btn" 
    type="button" 
    style="width:100%;padding:12px;background:#000;color:#fff;border:none;cursor:pointer;font-size:16px;">
    Request Purchase
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const email = prompt('Enter email address to send request to:');
        if (!email) return;

        try {
          const cart = await fetch('/cart.js').then(r => r.json());
          
          // Use App Proxy path in production
          const BACKEND = '/apps/request-purchase';

          // Optional: fallback for direct testing (disable for Shopify)
          // const BACKEND = window.location.hostname.includes('myshopify.com') 
          //   ? '/apps/request-purchase' 
          //   : 'https://purchase-request-13ki.onrender.com/apps/request-purchase';

          const response = await fetch(BACKEND, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, cart })
          });

          let result;
          try {
            result = await response.json();
          } catch {
            const text = await response.text();
            console.error("Non-JSON response:", text);
            result = null;
          }

          if (response.ok && result?.success) {
            alert('Request Sent!');
            console.log("Request successful:", result);
          } else {
            alert('Error sending request.');
            console.error("Request error:", response.status, result);
          }
        } catch (err) {
          console.error("Fetch error:", err);
          alert('Error sending request.');
        }
      });
    });
  </script>
</div>
