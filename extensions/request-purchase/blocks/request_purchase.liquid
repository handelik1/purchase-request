<div style="margin-top:20px;">
  <button id="request-purchase-btn" type="button"
    style="width:100%;padding:12px;background:#000;color:#fff;border:none;cursor:pointer;font-size:16px;">
    Request Purchase
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('request-purchase-btn');
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const email = prompt('Enter email address to send request to:');
        if (!email) return;

        try {
          const cart = await fetch('/cart.js').then(r => r.json());

          // Shopify's logged-in customer address
          const address = window?.Shopify?.customer?.default_address || null;

          const response = await fetch('/apps/request-purchase', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, cart, address })
          });

          const result = await response.json().catch(() => null);

          if (response.ok && result?.success) {
            alert('Request sent!');
          } else {
            alert('Error sending request.');
          }
        } catch (err) {
          console.error(err);
          alert('Error sending request.');
        }
      });
    });
  </script>
</div>
