<div style="margin-top:20px" class="button-wrapper-3">
  <button id="request-purchase-btn" type="button"
    style="width:100%;padding:12px;background:#000;color:#fff;border:none;cursor:pointer;font-size:16px;">
    Request Purchase
  </button>

  {%- if customer -%}
    {%- assign addr = customer.default_address | default: customer -%}

    <script>
      window.REQUESTER = {
        email: "{{ customer.email | escape }}",
        first_name: "{{ addr.first_name | escape }}",
        last_name: "{{ addr.last_name | escape }}",
        city: "{{ addr.city | escape }}",
        province: "{{ addr.province | escape }}",
        country: "{{ addr.country | escape }}"
      };
      console.log("REQUESTER:", window.REQUESTER);
    </script>
  {%- else -%}
    <script>
      window.REQUESTER = null;
    </script>
  {%- endif -%}

  <!-- REQUEST PURCHASE MODAL -->
  <div id="request-modal" style="
      display:none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.6); padding: 40px; z-index: 9999;">
    <div style="background:white; padding:30px; max-width:420px; margin:auto; border-radius:10px;">

      <h2 style="margin-bottom:10px;">Request Purchase</h2>

      <label>Email of the person who will approve the purchase</label>
      <input id="recipient-email" type="email"
        style="width:100%; padding:8px; margin:6px 0 14px;" />

      <label>Your Name</label>
      <input id="requester-name" type="text"
        style="width:100%; padding:8px; margin:6px 0 14px;" />

      <label>Your Location</label>
      <input id="requester-location" type="text" placeholder="City, State"
        style="width:100%; padding:8px; margin:6px 0 20px;" />

      <button id="send-request-btn"
        style="width:100%; padding:12px; background:black; color:white; cursor:pointer;">
        Send Request
      </button>

      <button id="close-request-modal"
        style="margin-top:10px; width:100%; padding:12px; background:#eee;">
        Cancel
      </button>

    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("request-modal");
      const openBtn = document.getElementById("request-purchase-btn");
      const closeBtn = document.getElementById("close-request-modal");
      const sendBtn = document.getElementById("send-request-btn");

      const inputRecipient = document.getElementById("recipient-email");
      const inputName = document.getElementById("requester-name");
      const inputLoc = document.getElementById("requester-location");

      const BACKEND_URL = "https://purchase-request-13ki.onrender.com/request-purchase";

      // Prefill name/location from window.REQUESTER
      function preloadRequesterFields() {
        if (!window.REQUESTER) return;

        inputName.value =
          (window.REQUESTER.first_name || "") +
          (window.REQUESTER.last_name ? " " + window.REQUESTER.last_name : "");

        let loc = "";
        if (window.REQUESTER.city) loc += window.REQUESTER.city;
        if (window.REQUESTER.province) loc += ", " + window.REQUESTER.province;
        if (window.REQUESTER.country) loc += " (" + window.REQUESTER.country + ")";

        inputLoc.value = loc;
      }

      // Open modal
      openBtn.addEventListener("click", () => {
        preloadRequesterFields();
        modal.style.display = "block";
      });

      // Close modal
      closeBtn.addEventListener("click", () => {
        modal.style.display = "none";
      });

      modal.addEventListener("click", (e) => {
        if (e.target === modal) modal.style.display = "none";
      });

      // Send request
      sendBtn.addEventListener("click", async () => {
        const recipient = inputRecipient.value.trim();
        const name = inputName.value.trim();
        const location = inputLoc.value.trim();

        if (!recipient) return alert("Please enter the recipient email.");
        if (!name) return alert("Please enter your name.");

        modal.style.display = "none";

        try {
          const cart = await fetch("/cart.js").then((res) => res.json());

          const payload = {
            recipient,
            requester: { name, location },
            cart
          };

          console.log("📤 Sending payload:", payload);

          const resp = await fetch(BACKEND_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          const data = await resp.json();

          if (data.success) {
            alert("Request sent successfully!");
          } else {
            alert("Error sending request.");
            console.error("Server error:", data);
          }
        } catch (e) {
          console.error("Network error:", e);
          alert("Unable to send request.");
        }
      });
    });
  </script>
</div>

{% schema %}
{
  "name": "Request Purchase Button",
  "target": "section",
  "settings": []
}
{% endschema %}
